---
import { getRouteKeyFromPathname, routes } from '../../i18n/ui';

interface Props {
  title: string;
  description: string;
  image?: string;
  locale: string;
  type?: 'website' | 'article' | 'product';
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/hm-digital-logo-veliki-social.png',
  locale,
  type = 'website',
  canonical,
  noindex = false
} = Astro.props;

const keywords = locale === 'hr'
  ? 'hm digital, HM Digital, HM-DIGITAL, hmdigital, softverski razvoj, web aplikacije, ERP sustavi, automatizacija, digitalizacija, Hrvatska'
  : 'hm digital, HM Digital, HM-DIGITAL, hmdigital, software development, web applications, ERP systems, automation, digitization, Croatia';

const siteUrl = 'https://hmdigital.hr';
const fullUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
const imageUrl = `${siteUrl}${image}`;
const alternateLocale = locale === 'hr' ? 'en' : 'hr';

// Normalize a path to match build.format 'directory' (trailing slash on non-root paths)
const withTrailingSlash = (p: string) => (p === '/' || p.endsWith('/') ? p : `${p}/`);

// Get the alternate URL using the route map
const routeKey = getRouteKeyFromPathname(canonical || '/');
const alternatePath = withTrailingSlash(routes[routeKey][alternateLocale as keyof typeof routes[typeof routeKey]]);
const alternateUrl = `${siteUrl}${alternatePath}`;

// x-default: the default-locale (HR) URL of THIS page (never the homepage unless on homepage)
const defaultLocalePath = withTrailingSlash(routes[routeKey].hr);
const defaultLocaleUrl = `${siteUrl}${defaultLocalePath}`;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={fullUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="HM Digital" />
<meta property="og:locale" content={locale === 'hr' ? 'hr_HR' : 'en_US'} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={fullUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<!-- hreflang tags -->
<link rel="alternate" hreflang={locale === 'hr' ? 'hr-HR' : 'en'} href={fullUrl} />
<link rel="alternate" hreflang={alternateLocale === 'hr' ? 'hr-HR' : 'en'} href={alternateUrl} />
<link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />
