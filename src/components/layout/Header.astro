---
import { getLocaleFromPath, getPathForLocale, getTranslations } from '../../i18n/ui';
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const locale = getLocaleFromPath(currentPath);
const homePath = getPathForLocale('/', locale);
const t = getTranslations(locale);

const productItems = [
  { key: 'medical', href: getPathForLocale('/medicinski-softver', locale) },
  { key: 'kontomatrix', href: getPathForLocale('/unos-racuna', locale) }
];

const navItems = [
  { key: 'home', href: homePath },
  { key: 'about', href: getPathForLocale('/o-nama', locale) },
  { key: 'services', href: getPathForLocale('/usluge', locale) },
  { key: 'products', href: '#' },
  { key: 'industries', href: getPathForLocale('/industrije', locale) },
  { key: 'pricing', href: getPathForLocale('/cjenik', locale) },
  { key: 'projects', href: getPathForLocale('/projekti', locale) },
  { key: 'freeAssessment', href: getPathForLocale('/besplatna-procjena', locale) },
  { key: 'contact', href: getPathForLocale('/kontakt', locale) }
];

function isActive(href: string, current: string): boolean {
  const normalizedCurrent = current.replace(/^\/en/, '') || '/';
  const normalizedHref = href.replace(/^\/en/, '') || '/';
  return normalizedCurrent === normalizedHref || normalizedCurrent.startsWith(normalizedHref + '/');
}

const productsActive = productItems.some((p) => isActive(p.href, currentPath));
---

<script>
  const menuIcon = document.getElementById('menu-icon') as HTMLElement;
  const closeIcon = document.getElementById('close-icon') as HTMLElement;

  function toggleMenu() {
    const menu = document.getElementById('mobile-menu');
    const isHidden = menu?.classList.contains('hidden');

    if (isHidden) {
      menu?.classList.remove('hidden');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    } else {
      menu?.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    }
  }

  function closeMenu() {
    const menu = document.getElementById('mobile-menu');
    menu?.classList.add('hidden');
    menuIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  // Close menu when clicking outside
  document.addEventListener('click', (e) => {
    const menu = document.getElementById('mobile-menu');
    const hamburger = document.getElementById('hamburger-button');
    if (menu && !menu.contains(e.target) && !hamburger?.contains(e.target) && !menu.classList.contains('hidden')) {
      closeMenu();
    }
  });

  // Close product dropdown when clicking outside or pressing Escape
  document.addEventListener('click', (e) => {
    document.querySelectorAll('[data-products-dd].dd-open').forEach((dd) => {
      if (!dd.contains(e.target as Node)) {
        (dd as HTMLElement).classList.remove('dd-open');
        dd.querySelector('button')?.setAttribute('aria-expanded', 'false');
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      document.querySelectorAll('[data-products-dd].dd-open').forEach((dd) => {
        (dd as HTMLElement).classList.remove('dd-open');
        const btn = dd.querySelector('button');
        btn?.setAttribute('aria-expanded', 'false');
        btn?.blur();
      });
    }
  });

  // Expose functions globally for onclick attributes
  (window as any).toggleMenu = toggleMenu;
  (window as any).closeMenu = closeMenu;
</script>

<style>
  [data-products-dd].dd-open [data-products-panel] {
    opacity: 1;
    visibility: visible;
  }
  [data-products-dd].dd-open > button > svg {
    transform: rotate(180deg);
  }
</style>

<header class="sticky top-0 z-50 bg-slate-900 border-b border-slate-700">
  <div class="container-custom xl:max-w-[1600px]!">
    <div class="header-row relative flex items-center justify-between py-4">
      <!-- Logo -->
      <a href={homePath} class="flex items-center gap-2 z-50 relative">
        <img src="/logo.svg" alt="HM Digital logo" class="w-10 h-10" />
        <span class="text-xl font-bold text-white">DIGITAL</span>
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label={t.nav.mainNav} class="desktop-nav hidden xl:flex items-center gap-6">
        {navItems.map((item) => {
          if (item.key === 'products') {
            return (
              <div class="relative group" data-products-dd>
                <button
                  type="button"
                  aria-expanded="false"
                  aria-haspopup="true"
                  onclick="const dd=this.closest('[data-products-dd]'); const open=dd.classList.toggle('dd-open'); this.setAttribute('aria-expanded', String(open));"
                  class={`flex items-center gap-1 text-base font-medium transition-colors cursor-pointer ${
                    productsActive ? 'text-primary-200' : 'text-white hover:text-primary-200'
                  }`}
                >
                  {t.nav.products}
                  <svg class="w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
                <div
                  data-products-panel
                  class="absolute left-1/2 -translate-x-1/2 top-full pt-3 opacity-0 invisible transition-opacity duration-150 group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible"
                >
                  <div class="bg-white rounded-lg shadow-lg border border-slate-200 py-2 min-w-56">
                    {productItems.map((p) => (
                      <a
                        href={p.href}
                        class={`block px-4 py-2.5 text-sm font-medium whitespace-nowrap transition-colors ${
                          isActive(p.href, currentPath)
                            ? 'bg-primary-50 text-primary-700'
                            : 'text-slate-700 hover:bg-primary-50 hover:text-primary-700'
                        }`}
                      >
                        {t.nav[p.key as keyof typeof t.nav]}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          }
          return (
            <a
              href={item.href}
              class={`text-base font-medium transition-colors ${
                isActive(item.href, currentPath)
                  ? 'text-primary-200'
                  : 'text-white hover:text-primary-200'
              }`}
            >
              {t.nav[item.key as keyof typeof t.nav]}
            </a>
          );
        })}
      </nav>

      <!-- Desktop Right side -->
      <div class="desktop-side hidden xl:flex items-center gap-6">
        <a
          href={`${getPathForLocale('/medicinski-softver', locale)}#demo-form`}
          class="whitespace-nowrap text-base font-medium text-white transition-colors hover:text-primary-200"
        >
          {locale === 'hr' ? 'Zatraži demo' : 'Request a demo'}
        </a>
        <LanguageSwitcher currentPath={currentPath} />
      </div>

      <!-- Phone (visibility is measured by the script below: "Tel" + icon on phones, full number on tablets and desktop widths with room) -->
      <a href="tel:+385977120800" class="header-phone hidden md:flex items-center gap-2 whitespace-nowrap text-sm font-medium text-white transition-colors hover:text-primary-200">
        <span class="header-phone-label hidden items-center">Tel</span>
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span class="header-phone-number">+385 97 7120 800</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="hamburger-button"
        onclick="toggleMenu()"
        class="header-burger xl:hidden p-2 text-white hover:text-primary-200 transition-colors"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden xl:hidden bg-slate-800 border-t border-slate-700 absolute w-full">
    <nav aria-label={t.nav.mainNav} class="container-custom py-4">
      <ul class="flex flex-col gap-2">
        {navItems.map((item) => {
          if (item.key === 'products') {
            return (
              <li>
                <details class="group/det">
                  <summary
                    class={`flex items-center justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden py-3 px-4 rounded-lg text-sm font-medium transition-colors ${
                      productsActive
                        ? 'bg-primary-900/30 text-primary-200'
                        : 'text-white hover:bg-slate-700'
                    }`}
                  >
                    {t.nav.products}
                    <svg class="w-4 h-4 transition-transform group-open/det:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </summary>
                  <div class="mt-1 ml-4 pl-4 border-l border-slate-600 flex flex-col gap-1">
                    {productItems.map((p) => (
                      <a
                        href={p.href}
                        onclick="closeMenu()"
                        class={`block py-2.5 px-4 rounded-lg text-sm font-medium transition-colors ${
                          isActive(p.href, currentPath)
                            ? 'text-primary-200'
                            : 'text-slate-300 hover:text-white hover:bg-slate-700'
                        }`}
                      >
                        {t.nav[p.key as keyof typeof t.nav]}
                      </a>
                    ))}
                  </div>
                </details>
              </li>
            );
          }
          return (
            <li>
              <a
                href={item.href}
                onclick="closeMenu()"
                class={`block py-3 px-4 rounded-lg text-sm font-medium transition-colors ${
                  isActive(item.href, currentPath)
                    ? 'bg-primary-900/30 text-primary-200'
                    : 'text-white hover:bg-slate-700'
                }`}
              >
                {t.nav[item.key as keyof typeof t.nav]}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="mt-4 pt-4 border-t border-slate-700 flex items-center justify-between gap-4">
        <LanguageSwitcher currentPath={currentPath} />
      </div>
    </nav>
  </div>

  <script is:inline>
    (function () {
      var header = document.querySelector('header');
      if (!header) return;
      var row = header.querySelector('.header-row');
      var nav = header.querySelector('.desktop-nav');
      var side = header.querySelector('.desktop-side');
      var phone = header.querySelector('.header-phone');
      var burger = header.querySelector('.header-burger');
      if (!row || !nav || !side || !phone || !burger) return;

      var md = window.matchMedia('(min-width: 768px)');
      var xl = window.matchMedia('(min-width: 1280px)');
      var number = header.querySelector('.header-phone-number');
      var label = header.querySelector('.header-phone-label');

      function apply(desktop, showPhone) {
        nav.style.display = desktop ? 'flex' : 'none';
        side.style.display = desktop ? 'flex' : 'none';
        burger.style.display = desktop ? 'none' : 'flex';
        phone.style.display = showPhone ? 'flex' : 'none';
        if (number) number.style.display = (desktop || md.matches) ? '' : 'none';
        // "Tel" caption only in the phone-size compact header, when there is room for it
        var showLabel = !desktop && !md.matches && showPhone && row.clientWidth >= 340;
        if (label) label.style.display = showLabel ? 'flex' : 'none';
        if (desktop) {
          phone.style.position = '';
          phone.style.left = '';
          phone.style.top = '';
          phone.style.transform = '';
        } else {
          // compact mode: pin the phone to the exact horizontal center of the row
          phone.style.position = 'absolute';
          phone.style.left = '50%';
          phone.style.top = '50%';
          phone.style.transform = 'translate(-50%, -50%)';
        }
        if (desktop && typeof window.closeMenu === 'function') window.closeMenu();
      }

      function fits() {
        return row.scrollWidth <= row.clientWidth + 1;
      }

      function update() {
        if (xl.matches) {
          apply(true, true);
          if (fits()) return;
          apply(true, false);
          if (fits()) return;
        }
        // compact: full number on tablets, icon-only on phones
        apply(false, true);
        if (!fits()) apply(false, false);
      }

      var t;
      function schedule() {
        clearTimeout(t);
        t = setTimeout(update, 100);
      }
      window.addEventListener('resize', schedule);
      // ResizeObserver catches viewport changes even where no resize event fires
      if (window.ResizeObserver) {
        var ro = new ResizeObserver(schedule);
        ro.observe(document.documentElement);
        ro.observe(row);
      }
      if (md.addEventListener) {
        md.addEventListener('change', schedule);
        xl.addEventListener('change', schedule);
      }
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(schedule);
      }
      // correct immediately when the tab becomes visible again (background tabs throttle timers)
      document.addEventListener('visibilitychange', schedule);
      window.__headerUpdate = update;
      schedule();
    })();
  </script>
</header>
