---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n/ui';
import PricingTable from '../../components/ui/PricingTable.astro';
import DigitizationPricingTable from '../../components/ui/DigitizationPricingTable.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';

const locale = 'en';
const t = getTranslations(locale);
---

<Layout
  title={`${t.pricing.title} - HM Digital | Software Development and Digitization Pricing`}
  description="Transparent pricing for software development and document digitization. From startup MVPs to complex SaaS platforms. Free project assessment available."
  canonical="/en/pricing/"
>
  <Breadcrumbs slot="head" currentLabel={t.pricing.title} />
  <PricingTable />
  <DigitizationPricingTable />

  <!-- Product: KontoMatrix -->
  <section class="py-12 bg-slate-50">
    <div class="container-custom text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">KontoMatrix - invoice capture for accounting firms</h2>
      <p class="text-slate-600 max-w-2xl mx-auto mb-4">Clients snap photos of invoices on their phone, the app reads the OIB, amount and line items, and export to Synesis, PANTHEON, Minimax or Luceed is one click.</p>
      <p class="text-primary-700 font-semibold mb-6">10 EUR per month per active client · minimum 50 EUR per month per office</p>
      <Button href="/en/invoice-capture/" variant="primary" size="md">Learn more</Button>
    </div>
  </section>
</Layout>
