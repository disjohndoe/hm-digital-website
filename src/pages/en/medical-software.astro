---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import MedicalPricingTable from '../../components/medical/MedicalPricingTable.astro';
import { getTranslations } from '../../i18n/ui';

const locale = 'en';
const t = getTranslations(locale);
const m = t.medicalLanding;
---

<Layout
  title={m.meta.title}
  description={m.meta.description}
  canonical="/en/medical-software/"
  type="product"
  noindex={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "HM Digital - Cloud CEZIH Software for Practices and Polyclinics",
      "applicationCategory": "HealthApplication",
      "operatingSystem": "Web",
      "description": m.hero.subtitle,
      "url": "https://hmdigital.hr/en/medical-software",
      "inLanguage": "en",
      "offers": [
        {
          "@type": "Offer",
          "name": m.pricing.solo.name,
          "price": "79",
          "priceCurrency": "EUR",
          "priceSpecification": { "@type": "UnitPriceSpecification", "unitText": "MONTH" },
          "description": m.pricing.solo.desc
        },
        {
          "@type": "Offer",
          "name": m.pricing.poliklinika.name,
          "price": "199",
          "priceCurrency": "EUR",
          "priceSpecification": { "@type": "UnitPriceSpecification", "unitText": "MONTH" },
          "description": m.pricing.poliklinika.desc
        }
      ],
      "provider": {
        "@type": "Organization",
        "name": "HM Digital",
        "url": "https://hmdigital.hr"
      },
      "featureList": [
        m.features.patients.title,
        m.features.scheduling.title,
        m.features.dentalChart.title,
        m.features.cezihModules.title,
        m.features.smartCard.title,
        m.features.cloudAccess.title,
        m.features.dental.title
      ]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": m.faq.items.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://hmdigital.hr/en/" },
        { "@type": "ListItem", "position": 2, "name": "Medical Software", "item": "https://hmdigital.hr/en/medical-software" }
      ]
    })} />
  </Fragment>

  <!-- 1. Urgency Bar - server-rendered fallback for SEO, JS-enhanced with countdown -->
  <div id="urgency-bar" class="bg-red-600 text-white text-sm text-center py-2 font-medium">
    <div class="container-custom">
      <span id="urgency-text">{m.urgencyBar.before.replace('{days}', '')}</span>
    </div>
  </div>

  <script is:inline>
    (function() {
      var deadline = new Date('2027-01-01T00:00:00+01:00');
      var now = new Date();
      var diff = deadline.getTime() - now.getTime();
      var days = Math.ceil(diff / (1000 * 60 * 60 * 24));
      var el = document.getElementById('urgency-text');
      if (!el) return;
      if (days > 0) {
        el.textContent = 'Days left to connect to CEZIH: ' + days + '. After the deadline, fines prescribed by law apply.';
      } else {
        el.textContent = 'Connecting to CEZIH is a legal obligation - deadline for private practices: 1 January 2027.';
      }
    })();
  </script>

  <!-- 2. Hero -->
  <section class="py-20 lg:py-32 bg-gradient-to-br from-slate-900 to-primary-900">
    <div class="container-custom text-center">
      <a href={m.hero.certBadgeLink} target="_blank" rel="external noopener" class="inline-flex items-center gap-2 px-4 py-2 mb-8 rounded-full bg-green-500/15 border border-green-400/40 text-green-200 text-sm font-semibold hover:bg-green-500/25 transition-colors">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {m.hero.certBadge}
        <svg class="w-3.5 h-3.5 shrink-0 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-6 max-w-4xl mx-auto leading-tight">
        {m.hero.title}
      </h1>
      <p class="text-lg sm:text-xl leading-relaxed text-slate-300 max-w-3xl mx-auto mb-10">
        {m.hero.subtitle}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="#demo-form" variant="primary" size="lg">
          {m.hero.ctaTrial}
        </Button>
        <Button href="#usporedba" variant="outline" size="lg" class="!border-white !text-white hover:!bg-white/10">
          {m.hero.ctaCompare}
        </Button>
      </div>
    </div>
  </section>

  <!-- 2b. Certification trust section -->
  <section id="certifikacija" class="py-12 lg:py-16 bg-gradient-to-br from-green-50 to-primary-50 border-y border-green-200">
    <div class="container-custom max-w-5xl">
      <div class="flex flex-col md:flex-row gap-8 items-start">
        <div class="shrink-0 w-16 h-16 rounded-2xl bg-green-600 flex items-center justify-center shadow-lg">
          <svg class="w-9 h-9 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div class="flex-1">
          <p class="inline-block px-3 py-1 bg-green-100 text-green-800 text-xs font-bold uppercase tracking-wider rounded-full mb-3">
            {m.cert.badge}
          </p>
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4 leading-tight">{m.cert.title}</h2>
          <p class="text-slate-700 leading-relaxed mb-6">{m.cert.body}</p>

          <h3 class="text-base font-semibold text-slate-900 mb-3">{m.cert.pointsTitle}</h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 mb-6">
            {m.cert.points.map((point) => (
              <li class="flex gap-2.5 text-slate-700 text-sm leading-relaxed">
                <svg class="w-5 h-5 text-green-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>{point}</span>
              </li>
            ))}
          </ul>

          <a href={m.cert.verifyUrl} target="_blank" rel="external noopener" class="inline-flex items-center gap-2 text-primary-700 font-semibold hover:text-primary-800">
            {m.cert.verifyLabel}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2c. Disambiguation: CEZIH, ID card, insurance certificate -->
  <section class="py-16 lg:py-24 bg-slate-50">
    <div class="container-custom max-w-4xl">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-8 text-center">{m.disambiguation.title}</h2>
      <div class="space-y-4">
        {m.disambiguation.rows.map((row) => (
          <div class="bg-white border border-slate-200 rounded-lg p-5">
            <h3 class="text-lg font-semibold text-slate-900 mb-1">{row.term}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{row.desc}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-sm text-slate-700 bg-amber-50 border border-amber-200 rounded-lg p-4 leading-relaxed">{m.disambiguation.caution}</p>
    </div>
  </section>

  <!-- 3. Problem Statement -->
  <section class="py-16 lg:py-24 bg-white" id="mogucnosti">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
          {m.problem.title}
        </h2>
        <p class="text-lg text-slate-600 max-w-3xl mx-auto">
          {m.problem.subtitle}
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <Card padding="lg">
          <div class="w-10 h-10 bg-red-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">{m.problem.deadline.title}</h3>
          <p class="text-slate-600 text-sm">{m.problem.deadline.desc}</p>
        </Card>
        <Card padding="lg">
          <div class="w-10 h-10 bg-amber-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">{m.problem.legacy.title}</h3>
          <p class="text-slate-600 text-sm">{m.problem.legacy.desc}</p>
        </Card>
        <Card padding="lg">
          <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">{m.problem.cloudNoCezih.title}</h3>
          <p class="text-slate-600 text-sm">{m.problem.cloudNoCezih.desc}</p>
        </Card>
      </div>
    </div>
  </section>

  <!-- 4. Emotional Bridge -->
  <section class="py-12 lg:py-16 bg-gradient-to-br from-slate-900 to-primary-900">
    <div class="container-custom text-center max-w-3xl mx-auto">
      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-4">
        {m.bridge.title}
      </h2>
      <p class="text-lg text-slate-300 leading-relaxed mb-4">
        {m.bridge.desc}
      </p>
      <p class="mt-6 flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/en/cezih-guide/" class="inline-block text-primary-200 underline underline-offset-4 hover:text-white text-sm font-medium">
          {m.bridge.guideLink}
        </a>
        <a href="/en/cezih-deadline-private-practices/" class="inline-block text-primary-200 underline underline-offset-4 hover:text-white text-sm font-medium">
          {m.bridge.deadlineLink}
        </a>
      </p>
    </div>
  </section>

  <!-- 5. Kako radi: 4 koraka -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-primary-50 to-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
          {m.howItWorks.title}
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-6xl mx-auto">
        {m.howItWorks.steps.map((step) => (
          <Card padding="lg" class="text-center">
            <div class="w-10 h-10 bg-primary-600 text-white rounded-full flex items-center justify-center mx-auto mb-4 font-bold">
              {step.n}
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">{step.title}</h3>
            <p class="text-slate-600 text-sm">{step.desc}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- 5b. For staff and for the doctor -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
          {m.audiences.title}
        </h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
          {m.audiences.intro}
        </p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 max-w-5xl mx-auto">
        <Card padding="lg">
          <h3 class="text-lg font-semibold text-slate-900 mb-4">{m.audiences.staffTitle}</h3>
          <ul class="space-y-3">
            {m.audiences.staff.map((line) => (
              <li class="flex gap-2.5 text-slate-600 text-sm leading-relaxed">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </Card>
        <Card padding="lg">
          <h3 class="text-lg font-semibold text-slate-900 mb-4">{m.audiences.doctorTitle}</h3>
          <ul class="space-y-3">
            {m.audiences.doctor.map((line) => (
              <li class="flex gap-2.5 text-slate-600 text-sm leading-relaxed">
                <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span>{line}</span>
              </li>
            ))}
          </ul>
        </Card>
      </div>
    </div>
  </section>

  <!-- 6. Features Grid (moved before Comparison) -->
  <section class="py-16 lg:py-24 bg-slate-50">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
          {m.features.title}
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        <Card padding="lg">
          <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">{m.features.patients.title}</h3>
          <p class="text-slate-600 text-sm">{m.features.patients.desc}</p>
        </Card>
        <Card padding="lg">
          <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">{m.features.scheduling.title}</h3>
          <p class="text-slate-600 text-sm">{m.features.scheduling.desc}</p>
        </Card>
        <Card padding="lg">
          <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">{m.features.dentalChart.title}</h3>
          <p class="text-slate-600 text-sm">{m.features.dentalChart.desc}</p>
        </Card>
        <Card padding="lg">
          <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">{m.features.cezihModules.title}</h3>
          <p class="text-slate-600 text-sm">{m.features.cezihModules.desc}</p>
        </Card>
        <Card padding="lg">
          <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">{m.features.smartCard.title}</h3>
          <p class="text-slate-600 text-sm">{m.features.smartCard.desc}</p>
        </Card>
        <Card padding="lg">
          <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">{m.features.cloudAccess.title}</h3>
          <p class="text-slate-600 text-sm">{m.features.cloudAccess.desc}</p>
        </Card>
        <Card padding="lg">
          <div class="w-10 h-10 bg-primary-100 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-slate-900 mb-2">{m.features.dental.title}</h3>
          <p class="text-slate-600 text-sm">{m.features.dental.desc}</p>
        </Card>
      </div>
    </div>
  </section>

  <!-- 6b. CMS for polyclinics and practices -->
  <section class="py-16 lg:py-24 bg-slate-50" id="cms">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6">{m.cms.title}</h2>
        <p class="text-lg text-slate-600 leading-relaxed mb-4">{m.cms.body1}</p>
        <p class="text-lg text-slate-600 leading-relaxed">{m.cms.body2}</p>
      </div>
    </div>
  </section>

  <!-- 7. Comparison Table -->
  <section class="py-16 lg:py-24 bg-white" id="usporedba">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
          {m.comparison.title}
        </h2>
      </div>
      <div class="max-w-4xl mx-auto overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b-2 border-slate-200">
              <th class="py-4 px-4 text-sm font-semibold text-slate-500">{m.comparison.headers.feature}</th>
              <th class="py-4 px-4 text-sm font-semibold text-slate-500 text-center">{m.comparison.headers.legacy}</th>
              <th class="py-4 px-4 text-sm font-semibold text-slate-500 text-center">{m.comparison.headers.cloudAlt}</th>
              <th class="py-4 px-4 text-sm font-semibold text-primary-600 text-center">{m.comparison.headers.hmDigital}</th>
            </tr>
          </thead>
          <tbody>
            {Object.entries(m.comparison.rows).map(([key, label]) => (
              <tr class="border-b border-slate-100">
                <td class="py-3 px-4 text-sm text-slate-700 font-medium">{label}</td>
                <td class="py-3 px-4 text-center">
                  {typeof m.comparison.legacy[key] === 'boolean' ? (
                    m.comparison.legacy[key] ? (
                      <svg class="w-5 h-5 text-green-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    ) : (
                      <svg class="w-5 h-5 text-red-400 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    )
                  ) : (
                    <span class="text-sm text-slate-600">{m.comparison.legacy[key]}</span>
                  )}
                </td>
                <td class="py-3 px-4 text-center">
                  {typeof m.comparison.cloudAlt[key] === 'boolean' ? (
                    m.comparison.cloudAlt[key] ? (
                      <svg class="w-5 h-5 text-green-500 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    ) : (
                      <svg class="w-5 h-5 text-red-400 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    )
                  ) : (
                    <span class="text-sm text-slate-600">{m.comparison.cloudAlt[key]}</span>
                  )}
                </td>
                <td class="py-3 px-4 text-center bg-primary-50/50">
                  {typeof m.comparison.hmDigital[key] === 'boolean' ? (
                    m.comparison.hmDigital[key] ? (
                      <svg class="w-5 h-5 text-primary-600 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    ) : (
                      <svg class="w-5 h-5 text-red-400 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
                    )
                  ) : (
                    <span class="text-sm font-semibold text-primary-600">{m.comparison.hmDigital[key]}</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <!-- Mid-page CTA after comparison -->
    <div class="text-center mt-10">
      <Button href="#demo-form" variant="primary" size="lg">
        {m.hero.ctaTrial}
      </Button>
    </div>
  </section>

  <!-- 8. Pricing Table -->
  <MedicalPricingTable t={t} />

  <!-- 8a. Pricing notes: ID card + data residency -->
  <section class="bg-slate-50 pb-12">
    <div class="container-custom max-w-3xl mx-auto text-center text-sm text-slate-600 space-y-2 px-4">
      <p>{m.pricing.cautionNote}</p>
      <p>{m.pricing.residencyNote}</p>
    </div>
  </section>

  <!-- 8b. Practice software -->
  <section class="py-16 lg:py-24 bg-white" id="practice-software">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6">{m.ordinacije.title}</h2>
        <p class="text-lg text-slate-600 leading-relaxed mb-4">{m.ordinacije.body1}</p>
        <p class="text-lg text-slate-600 leading-relaxed">{m.ordinacije.body2}</p>
      </div>
    </div>
  </section>

  <!-- 9. Stats -->
  <section class="py-10 lg:py-14 bg-slate-900">
    <div class="container-custom">
      <div class="flex flex-col sm:flex-row gap-8 justify-center items-center text-center">
        <div>
          <div class="text-3xl sm:text-4xl font-bold text-white">{m.stats.clinics.value}</div>
          <div class="text-sm text-slate-400 mt-1">{m.stats.clinics.label}</div>
        </div>
        <div class="hidden sm:block w-px h-12 bg-slate-700"></div>
        <div>
          <div class="text-3xl sm:text-4xl font-bold text-green-400">{m.stats.cert.value}</div>
          <div class="text-sm text-slate-400 mt-1">{m.stats.cert.label}</div>
        </div>
        <div class="hidden sm:block w-px h-12 bg-slate-700"></div>
        <div>
          <div class="text-3xl sm:text-4xl font-bold text-white">{m.stats.deadline.value}</div>
          <div class="text-sm text-slate-400 mt-1">{m.stats.deadline.label}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
          {m.faq.title}
        </h2>
      </div>
      <div class="max-w-3xl mx-auto space-y-3">
        {m.faq.items.map((item) => (
          <details class="group border border-slate-200 rounded-lg">
            <summary class="flex items-center justify-between cursor-pointer p-4 sm:p-5 font-medium text-slate-900 hover:bg-slate-50 rounded-lg transition-colors">
              {item.q}
              <svg class="w-5 h-5 text-slate-400 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-4 sm:px-5 pb-4 sm:pb-5 text-slate-600 text-sm leading-relaxed">
              {item.a}
            </div>
          </details>
        ))}
      </div>
      <p class="mt-8 text-center text-sm text-slate-600">
        Looking for deeper background on CEZIH, deadlines, and fines?
        Read our <a href="/en/cezih-guide/" class="text-primary-700 font-medium underline hover:text-primary-800">complete CEZIH guide for private practices</a>.
      </p>
    </div>
  </section>

  <!-- 11. CTA + Contact Form -->
  <section class="py-16 lg:py-24 bg-primary-600" id="demo-form">
    <div class="container-custom">
      <div class="text-center mb-10">
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
          {m.cta.title}
        </h2>
        <p class="text-lg text-primary-100 max-w-2xl mx-auto">
          {m.cta.subtitle}
        </p>
      </div>
      <div class="max-w-lg mx-auto">
        <form
          action="https://formspree.io/f/mgokrggg"
          method="POST"
          class="bg-white rounded-xl shadow-lg p-6 lg:p-8"
          data-form-security
        >
          <!-- Honeypot -->
          <div style="position: absolute; left: -5000px;" aria-hidden="true">
            <label for="_honey_med_en">Do not fill:</label>
            <input type="text" id="_honey_med_en" name="_honey" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="_form_timestamp" value="" />
          <input type="hidden" name="_subject" value="Medical MVP - Demo request" />
          <input type="hidden" name="_source" value="medical-software" />

          <div class="space-y-6">
            <div>
              <label for="med-name-en" class="block text-sm font-medium text-slate-700 mb-2">
                {m.cta.form.name}
              </label>
              <input
                type="text"
                id="med-name-en"
                name="name"
                required
                class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors placeholder:text-slate-400"
                placeholder={m.cta.form.namePlaceholder}
              />
            </div>
            <div>
              <label for="med-email-en" class="block text-sm font-medium text-slate-700 mb-2">
                {m.cta.form.email}
              </label>
              <input
                type="email"
                id="med-email-en"
                name="email"
                required
                class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors placeholder:text-slate-400"
                placeholder={m.cta.form.emailPlaceholder}
              />
            </div>
            <div>
              <label for="med-clinic-en" class="block text-sm font-medium text-slate-700 mb-2">
                {m.cta.form.clinic}
              </label>
              <input
                type="text"
                id="med-clinic-en"
                name="clinic"
                required
                class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors placeholder:text-slate-400"
                placeholder={m.cta.form.clinicPlaceholder}
              />
            </div>
            <div>
              <label for="med-phone-en" class="block text-sm font-medium text-slate-700 mb-2">
                {m.cta.form.phone}
              </label>
              <input
                type="tel"
                id="med-phone-en"
                name="phone"
                class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-colors placeholder:text-slate-400"
                placeholder={m.cta.form.phonePlaceholder}
              />
            </div>
            <Button type="submit" variant="primary" size="lg" class="w-full">
              {m.cta.form.submit}
            </Button>
          </div>
        </form>

        <div class="mt-8 text-center">
          <p class="text-primary-100 mb-2">{m.cta.directContact}</p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={`mailto:${m.cta.email}`} class="text-white font-semibold hover:text-primary-200 transition-colors">
              {m.cta.email}
            </a>
            <a href={`tel:${m.cta.phone.replace(/\s/g, '')}`} class="text-white font-semibold hover:text-primary-200 transition-colors">
              {m.cta.phone}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline src="/js/form-security.js"></script>
</Layout>
