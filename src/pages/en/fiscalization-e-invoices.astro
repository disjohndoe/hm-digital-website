---
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/ui/Card.astro';
import Button from '../../components/ui/Button.astro';
import { getTranslations } from '../../i18n/ui';

const locale = 'en';
const t = getTranslations(locale);
const g = t.fiskalizacijaGuide;

const siteUrl = 'https://hmdigital.hr';
const pageUrl = `${siteUrl}/en/fiscalization-e-invoices/`;
---

<Layout
  title={g.meta.title}
  description={g.meta.description}
  canonical="/en/fiscalization-e-invoices/"
  type="article"
  noindex={false}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={g.meta.datePublished} />
    <meta property="article:modified_time" content={g.meta.dateModified} />
    <meta property="article:author" content={g.meta.authorName} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": g.hero.title,
      "description": g.meta.description,
      "datePublished": g.meta.datePublished,
      "dateModified": g.meta.dateModified,
      "inLanguage": "en",
      "author": { "@type": "Person", "name": g.meta.authorName, "worksFor": { "@type": "Organization", "name": "HM Digital", "url": siteUrl } },
      "publisher": {
        "@type": "Organization",
        "name": "HM Digital",
        "url": siteUrl,
        "logo": { "@type": "ImageObject", "url": `${siteUrl}/hm-digital-logo-veliki-social.png` }
      },
      "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
      "image": `${siteUrl}/hm-digital-logo-veliki-social.png`,
      "about": ["Fiscalization 2.0", "e-invoices Croatia", "JIR", "ZKI", "QR code", "Croatian Tax Administration"]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": g.faq.items.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": g.breadcrumb.home, "item": `${siteUrl}/en/` },
        { "@type": "ListItem", "position": 2, "name": g.breadcrumb.current, "item": pageUrl }
      ]
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-slate-900 to-primary-900">
    <div class="container-custom max-w-4xl">
      <p class="text-xs sm:text-sm font-semibold tracking-wider text-primary-300 uppercase mb-4">
        {g.hero.eyebrow}
      </p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4 leading-tight">
        {g.hero.title}
      </h1>
      <p class="text-sm text-slate-300 mb-4">
        {g.meta.dateModifiedDisplay} · {g.meta.authorName}
      </p>
      <p class="text-base sm:text-lg text-slate-200 mb-5 max-w-3xl">
        {g.hero.subheadline}
      </p>
      <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary-500/20 border border-primary-400/40 text-primary-100 text-sm font-medium mb-6">
        <svg class="w-4 h-4 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {g.hero.promise}
      </div>
      <p class="text-lg sm:text-xl leading-relaxed text-slate-300 mb-8">
        {g.hero.lead}
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <Button href="#datumi" variant="primary" size="lg">
          {g.hero.ctaPrimary}
        </Button>
        <Button href="#faq" variant="outline" size="lg" class="!border-white !text-white hover:!bg-white/10">
          {g.hero.ctaSecondary}
        </Button>
      </div>
    </div>
  </section>

  <!-- TOC -->
  <nav class="py-6 bg-slate-50 border-b border-slate-200" aria-label={g.toc.title}>
    <div class="container-custom max-w-4xl">
      <details class="sm:open" open>
        <summary class="cursor-pointer sm:cursor-default font-semibold text-slate-700 text-sm sm:hidden flex items-center justify-between">
          {g.toc.title}
          <svg class="w-4 h-4 text-slate-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </summary>
        <div class="hidden sm:flex sm:items-center sm:gap-2 mb-2 text-xs uppercase tracking-wider font-semibold text-slate-500">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
          {g.toc.title}
        </div>
        <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm mt-3 sm:mt-0">
          {g.toc.items.map((item) => (
            <li>
              <a href={item.href} class="text-primary-700 hover:text-primary-800 hover:underline">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </nav>

  <!-- TL;DR -->
  <section id="tldr" class="py-12 lg:py-16 bg-amber-50 border-b border-amber-200">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-6">{g.tldr.title}</h2>
      <ul class="space-y-3">
        {g.tldr.points.map((p) => (
          <li class="flex gap-3 text-slate-700 leading-relaxed">
            <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- What is Fiscalization 2.0 -->
  <section id="sto-je" class="py-16 lg:py-20 bg-white">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">{g.stoJe.title}</h2>
      <p class="text-slate-700 leading-relaxed mb-8">{g.stoJe.body}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
        <Card padding="lg" class="border-l-4 border-primary-500 bg-slate-50">
          <h3 class="text-base font-semibold text-slate-900 mb-2">{g.stoJe.b2cCard.title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{g.stoJe.b2cCard.desc}</p>
        </Card>
        <Card padding="lg" class="border-l-4 border-primary-500 bg-slate-50">
          <h3 class="text-base font-semibold text-slate-900 mb-2">{g.stoJe.b2bCard.title}</h3>
          <p class="text-slate-600 text-sm leading-relaxed">{g.stoJe.b2bCard.desc}</p>
        </Card>
      </div>
      <h3 class="text-xl font-semibold text-slate-900 mb-3">{g.stoJe.ukidanoTitle}</h3>
      <p class="text-slate-700 leading-relaxed">{g.stoJe.ukidanoBody}</p>
    </div>
  </section>

  <!-- Key dates -->
  <section id="datumi" class="py-16 lg:py-20 bg-slate-50">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-8">{g.datumi.title}</h2>
      <ol class="space-y-6 border-l-2 border-primary-200 pl-6">
        {g.datumi.items.map((item) => (
          <li class="relative">
            <span class="absolute -left-[31px] top-1 w-4 h-4 rounded-full bg-primary-500 border-4 border-white shadow"></span>
            <p class="text-sm font-semibold text-primary-700 uppercase tracking-wide">{item.date}</p>
            <h3 class="text-lg font-semibold text-slate-900 mb-1">{item.title}</h3>
            <p class="text-slate-700 leading-relaxed">{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- JIR, ZKI and QR code -->
  <section id="kratice" class="py-16 lg:py-20 bg-white">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-8">{g.kratice.title}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-8">
        {g.kratice.items.map((item) => (
          <Card padding="lg">
            <p class="text-2xl font-bold text-primary-700 mb-1">{item.term}</p>
            <p class="text-xs uppercase tracking-wider font-semibold text-slate-500 mb-3">{item.full}</p>
            <p class="text-slate-600 text-sm leading-relaxed">{item.desc}</p>
          </Card>
        ))}
      </div>
      <Card padding="lg" class="bg-slate-50 border-slate-200">
        <h3 class="text-base font-semibold text-slate-900 mb-2">{g.kratice.provjeraTitle}</h3>
        <p class="text-slate-700 leading-relaxed text-sm">{g.kratice.provjeraBody}</p>
      </Card>
    </div>
  </section>

  <!-- B2C -->
  <section id="b2c" class="py-16 lg:py-20 bg-slate-50">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">{g.b2c.title}</h2>
      <p class="text-slate-700 leading-relaxed mb-4">{g.b2c.body1}</p>
      <p class="text-slate-700 leading-relaxed">{g.b2c.body2}</p>
    </div>
  </section>

  <!-- B2B -->
  <section id="b2b" class="py-16 lg:py-20 bg-white">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-8">{g.b2b.title}</h2>
      <h3 class="text-xl font-semibold text-primary-700 mb-2">{g.b2b.tkoTitle}</h3>
      <p class="text-slate-700 leading-relaxed mb-8">{g.b2b.tkoBody}</p>
      <h3 class="text-xl font-semibold text-primary-700 mb-2">{g.b2b.stoTitle}</h3>
      <p class="text-slate-700 leading-relaxed mb-8">{g.b2b.stoBody}</p>
      <h3 class="text-xl font-semibold text-primary-700 mb-2">{g.b2b.fiskTitle}</h3>
      <p class="text-slate-700 leading-relaxed mb-8">{g.b2b.fiskBody}</p>
      <h3 class="text-xl font-semibold text-primary-700 mb-2">{g.b2b.razmjenaTitle}</h3>
      <p class="text-slate-700 leading-relaxed">{g.b2b.razmjenaBody}</p>
    </div>
  </section>

  <!-- Preparation -->
  <section id="priprema" class="py-16 lg:py-20 bg-slate-50">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">{g.priprema.title}</h2>
      <p class="text-slate-700 leading-relaxed mb-10">{g.priprema.intro}</p>
      <ol class="space-y-6">
        {g.priprema.steps.map((step, i) => (
          <li class="flex gap-5">
            <div class="shrink-0 w-10 h-10 rounded-full bg-primary-600 text-white font-bold flex items-center justify-center">
              {i + 1}
            </div>
            <div>
              <h3 class="text-lg font-semibold text-slate-900 mb-1">{step.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PU applications -->
  <section id="aplikacije" class="py-16 lg:py-20 bg-white">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-8">{g.aplikacije.title}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {g.aplikacije.items.map((item) => (
          <Card padding="lg">
            <h3 class="text-lg font-semibold text-primary-700 mb-3">{item.title}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{item.desc}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Fines -->
  <section id="kazne" class="py-16 lg:py-20 bg-slate-50">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-6">{g.kazne.title}</h2>
      <p class="text-slate-700 leading-relaxed mb-8">
        {g.kazne.intro}
        {' '}<a href={g.kazne.lawLinkUrl} target="_blank" rel="external noopener" class="text-primary-700 underline hover:text-primary-800">{g.kazne.lawLinkLabel}</a>.
      </p>
      <Card padding="lg" class="bg-red-50 border-red-200 mb-6">
        <h3 class="text-lg font-semibold text-slate-900 mb-1">{g.kazne.heavyTitle}</h3>
        <p class="text-slate-600 text-sm mb-4">{g.kazne.heavyNote}</p>
        <ul class="space-y-2">
          {g.kazne.heavyItems.map((item) => (
            <li class="flex gap-3 text-slate-700 text-sm">
              <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </Card>
      <Card padding="lg" class="bg-white mb-6">
        <h3 class="text-lg font-semibold text-slate-900 mb-1">{g.kazne.seriousTitle}</h3>
        <p class="text-slate-600 text-sm mb-4">{g.kazne.seriousNote}</p>
        <ul class="space-y-2">
          {g.kazne.seriousItems.map((item) => (
            <li class="flex gap-3 text-slate-700 text-sm">
              <svg class="w-5 h-5 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </Card>
      <Card padding="lg" class="bg-white mb-8">
        <h3 class="text-lg font-semibold text-slate-900 mb-1">{g.kazne.lightTitle}</h3>
        <p class="text-slate-600 text-sm mb-4">{g.kazne.lightNote}</p>
        <ul class="space-y-2">
          {g.kazne.lightItems.map((item) => (
            <li class="flex gap-3 text-slate-700 text-sm">
              <svg class="w-5 h-5 text-slate-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </Card>
      <p class="text-slate-700 leading-relaxed bg-white border-l-4 border-primary-500 p-4 italic">
        {g.kazne.callout}
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-24 bg-white" id="faq">
    <div class="container-custom max-w-3xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-8 text-center">{g.faq.title}</h2>
      <div class="space-y-3">
        {g.faq.items.map((item) => (
          <details class="group border border-slate-200 rounded-lg bg-slate-50">
            <summary class="flex items-center justify-between cursor-pointer p-4 sm:p-5 font-medium text-slate-900 hover:bg-slate-100 rounded-lg transition-colors">
              {item.q}
              <svg class="w-5 h-5 text-slate-400 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-4 sm:px-5 pb-4 sm:pb-5 text-slate-600 text-sm leading-relaxed">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="cta" class="py-16 lg:py-24 bg-primary-600">
    <div class="container-custom max-w-3xl text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{g.cta.title}</h2>
      <p class="text-lg text-primary-100 leading-relaxed mb-8">{g.cta.body}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={g.cta.primaryHref} variant="primary" size="lg" class="!bg-white !text-primary-700 hover:!bg-primary-50">
          {g.cta.primaryLabel}
        </Button>
        <Button href={g.cta.secondaryHref} variant="outline" size="lg" class="!border-white !text-white hover:!bg-white/10">
          {g.cta.secondaryLabel}
        </Button>
      </div>
    </div>
  </section>

  <!-- Sources -->
  <section id="izvori" class="py-12 lg:py-16 bg-white border-t border-slate-200">
    <div class="container-custom max-w-3xl">
      <h2 class="text-lg font-semibold text-slate-900 mb-4">{g.sources.title}</h2>
      <p class="text-xs text-slate-500 mb-4 italic">{g.sources.disclaimer}</p>
      <ul class="space-y-2 text-sm">
        {g.sources.items.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="external noopener" class="text-primary-700 hover:text-primary-800 underline">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
