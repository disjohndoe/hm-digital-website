---
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../i18n/ui';
import PricingTable from '../components/ui/PricingTable.astro';
import DigitizationPricingTable from '../components/ui/DigitizationPricingTable.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import Button from '../components/ui/Button.astro';

const locale = 'hr';
const t = getTranslations(locale);
---

<Layout
  title={`${t.pricing.title} - HM Digital | Softverski razvoj i digitalizacija`}
  description="Transparentne cijene softverskog razvoja i digitalizacije dokumenata. Od startup MVP-a do kompleksnih SaaS platformi. Besplatna procjena projekta."
  canonical="/cjenik/"
>
  <Breadcrumbs slot="head" currentLabel={t.pricing.title} />
  <PricingTable />
  <DigitizationPricingTable />

  <!-- Produkt: KontoMatrix -->
  <section class="py-12 bg-slate-50">
    <div class="container-custom text-center">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">KontoMatrix - unos i skeniranje računa za urede</h2>
      <p class="text-slate-600 max-w-2xl mx-auto mb-4">Klijenti (ili vi za njih) slikaju račune mobitelom, aplikacija čita OIB, iznos i stavke, a izvoz u Synesis, PANTHEON, Minimax ili Luceed ide jednim klikom.</p>
      <p class="text-primary-700 font-semibold mb-6">10 EUR mjesečno po aktivnom klijentu · minimum 50 EUR mjesečno po uredu</p>
      <Button href="/unos-racuna/" variant="primary" size="md">Saznajte više</Button>
    </div>
  </section>
</Layout>
