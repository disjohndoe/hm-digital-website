---
import Layout from '../layouts/Layout.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import { getTranslations } from '../i18n/ui';

const locale = 'hr';
const t = getTranslations(locale);
const g = t.unosGuide;

const siteUrl = 'https://hmdigital.hr';
const pageUrl = `${siteUrl}/kako-ubrzati-unos-primljenih-racuna/`;
---

<Layout
  title={g.meta.title}
  description={g.meta.description}
  canonical="/kako-ubrzati-unos-primljenih-racuna/"
  type="article"
  noindex={false}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={g.meta.datePublished} />
    <meta property="article:modified_time" content={g.meta.dateModified} />
    <meta property="article:author" content={g.meta.authorName} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": g.hero.title,
      "description": g.meta.description,
      "datePublished": g.meta.datePublished,
      "dateModified": g.meta.dateModified,
      "inLanguage": "hr",
      "author": { "@type": "Person", "name": g.meta.authorName, "worksFor": { "@type": "Organization", "name": "HM Digital", "url": siteUrl } },
      "publisher": {
        "@type": "Organization",
        "name": "HM Digital",
        "url": siteUrl,
        "logo": { "@type": "ImageObject", "url": `${siteUrl}/hm-digital-logo-veliki-social.png` }
      },
      "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
      "image": `${siteUrl}/hm-digital-logo-veliki-social.png`,
      "about": ["unos računa", "skeniranje računa", "računovodstveni uredi", "OCR", "e-Računi"]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": g.faq.items.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": g.breadcrumb.home, "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": g.breadcrumb.current, "item": pageUrl }
      ]
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-slate-900 to-primary-900">
    <div class="container-custom max-w-4xl">
      <p class="text-xs sm:text-sm font-semibold tracking-wider text-primary-300 uppercase mb-4">
        {g.hero.eyebrow}
      </p>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4 leading-tight">
        {g.hero.title}
      </h1>
      <p class="text-sm text-slate-300 mb-4">
        {g.meta.dateModifiedDisplay} · {g.meta.authorName}
      </p>
      <p class="text-base sm:text-lg text-slate-200 mb-5 max-w-3xl">
        {g.hero.lead}
      </p>
      <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary-500/20 border border-primary-400/40 text-primary-100 text-sm font-medium mb-6">
        <svg class="w-4 h-4 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        {g.hero.promise}
      </div>
      <div class="flex flex-col sm:flex-row gap-4">
        <Button href="#sedam-koraka" variant="primary" size="lg">
          {g.hero.ctaPrimary}
        </Button>
        <Button href="#tri-nacina" variant="outline" size="lg" class="!border-white !text-white hover:!bg-white/10">
          {g.hero.ctaSecondary}
        </Button>
      </div>
    </div>
  </section>

  <!-- TOC -->
  <nav class="py-6 bg-slate-50 border-b border-slate-200" aria-label={g.toc.title}>
    <div class="container-custom max-w-4xl">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
        {g.toc.items.map((item) => (
          <li>
            <a href={item.href} class="text-primary-700 hover:text-primary-800 hover:underline">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- TL;DR -->
  <section id="sazetak" class="py-12 lg:py-16 bg-amber-50 border-b border-amber-200">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-6">{g.tldr.title}</h2>
      <ul class="space-y-3">
        {g.tldr.points.map((p) => (
          <li class="flex gap-3 text-slate-700 leading-relaxed">
            <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Why slow -->
  <section id="zasto-spor" class="py-16 lg:py-20 bg-white">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-6">{g.whySlow.title}</h2>
      <p class="text-slate-700 leading-relaxed mb-4">{g.whySlow.body1}</p>
      <p class="text-slate-700 leading-relaxed mb-4">{g.whySlow.body2}</p>
      <p class="text-slate-700 leading-relaxed mb-10">{g.whySlow.body3}</p>
      <h3 class="text-xl font-semibold text-slate-900 mb-4">{g.whySlow.mythsTitle}</h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {g.whySlow.myths.map((m) => (
          <Card padding="lg" class="border-l-4 border-red-300 bg-white">
            <h4 class="text-base font-semibold text-slate-900 mb-2">{m.title}</h4>
            <p class="text-slate-600 text-sm leading-relaxed">{m.desc}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Three ways -->
  <section id="tri-nacina" class="py-16 lg:py-20 bg-slate-50">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">{g.threeWays.title}</h2>
      <p class="text-slate-700 leading-relaxed mb-8">{g.threeWays.intro}</p>
      <div class="overflow-x-auto mb-8">
        <table class="w-full border-collapse text-sm sm:text-base">
          <thead>
            <tr>
              <th class="text-left p-3 sm:p-4 font-semibold text-slate-700 bg-slate-100 rounded-tl-lg w-1/4">{g.threeWays.headers.feature}</th>
              <th class="text-left p-3 sm:p-4 font-semibold text-slate-700 bg-slate-100">{g.threeWays.headers.manual}</th>
              <th class="text-left p-3 sm:p-4 font-semibold text-slate-700 bg-slate-100">{g.threeWays.headers.suite}</th>
              <th class="text-left p-3 sm:p-4 font-semibold text-slate-900 bg-primary-50 border-2 border-b-0 border-primary-500 rounded-tr-lg">{g.threeWays.headers.app}</th>
            </tr>
          </thead>
          <tbody>
            {g.threeWays.rows.map((row, i) => {
              const isLast = i === g.threeWays.rows.length - 1;
              return (
                <tr class={i % 2 === 0 ? 'bg-white' : 'bg-slate-50/50'}>
                  <td class={`p-3 sm:p-4 font-medium text-slate-800 align-top ${isLast ? 'rounded-bl-lg' : ''}`}>{row.feature}</td>
                  <td class="p-3 sm:p-4 text-slate-600 align-top">{row.manual}</td>
                  <td class="p-3 sm:p-4 text-slate-600 align-top">{row.suite}</td>
                  <td class={`p-3 sm:p-4 text-slate-800 font-medium align-top bg-primary-50 border-l-2 border-r-2 border-primary-500 ${isLast ? 'border-b-2 rounded-br-lg' : ''}`}>{row.app}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="text-slate-700 leading-relaxed bg-white border-l-4 border-primary-500 p-4">
        {g.threeWays.honesty}
      </p>
    </div>
  </section>

  <!-- Steps -->
  <section id="sedam-koraka" class="py-16 lg:py-20 bg-white">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">{g.steps.title}</h2>
      <p class="text-slate-700 leading-relaxed mb-10">{g.steps.intro}</p>
      <ol class="space-y-6">
        {g.steps.items.map((step) => (
          <li class="flex gap-5">
            <div class="shrink-0 w-10 h-10 rounded-full bg-primary-600 text-white font-bold flex items-center justify-center">
              {step.n}
            </div>
            <div>
              <h3 class="text-lg font-semibold text-slate-900 mb-1">{step.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- When to automate -->
  <section id="kada-automatizirati" class="py-16 lg:py-20 bg-slate-50">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">{g.whenAutomate.title}</h2>
      <p class="text-slate-700 leading-relaxed mb-6">{g.whenAutomate.intro}</p>
      <ul class="space-y-2 mb-8">
        {g.whenAutomate.signals.map((s) => (
          <li class="flex gap-3 text-slate-700">
            <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>{s}</span>
          </li>
        ))}
      </ul>
      <p class="text-slate-700 leading-relaxed mb-6">{g.whenAutomate.body}</p>
      <p class="text-slate-700">
        {g.whenAutomate.calcTeaser}{' '}
        <a href="/unos-racuna/#kalkulator" class="text-primary-700 underline hover:text-primary-800 font-medium">
          {g.whenAutomate.calcLabel}
        </a>
      </p>
    </div>
  </section>

  <!-- e-Invoices -->
  <section id="e-racuni" class="py-16 lg:py-20 bg-white">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-6">{g.ereg.title}</h2>
      <p class="text-slate-700 leading-relaxed mb-4">{g.ereg.body1}</p>
      <p class="text-slate-700 leading-relaxed mb-6">{g.ereg.body2}</p>
      <p class="text-slate-700 leading-relaxed bg-primary-50 border-l-4 border-primary-500 p-4">
        {g.ereg.note}
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-24 bg-slate-50" id="faq">
    <div class="container-custom max-w-3xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-8 text-center">{g.faq.title}</h2>
      <div class="space-y-3">
        {g.faq.items.map((item) => (
          <details class="group border border-slate-200 rounded-lg bg-white">
            <summary class="flex items-center justify-between cursor-pointer p-4 sm:p-5 font-medium text-slate-900 hover:bg-slate-50 rounded-lg transition-colors">
              {item.q}
              <svg class="w-5 h-5 text-slate-400 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-4 sm:px-5 pb-4 sm:pb-5 text-slate-600 text-sm leading-relaxed">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="cta" class="py-16 lg:py-24 bg-primary-600">
    <div class="container-custom max-w-3xl text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{g.cta.title}</h2>
      <p class="text-lg text-primary-100 leading-relaxed mb-8">{g.cta.body}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={g.cta.primaryHref} variant="primary" size="lg" class="!bg-white !text-primary-700 hover:!bg-primary-50">
          {g.cta.primaryLabel}
        </Button>
        <Button href={g.cta.secondaryHref} variant="outline" size="lg" class="!border-white !text-white hover:!bg-white/10">
          {g.cta.secondaryLabel}
        </Button>
      </div>
    </div>
  </section>

  <!-- Sources -->
  <section id="sources" class="py-12 lg:py-16 bg-white border-t border-slate-200">
    <div class="container-custom max-w-3xl">
      <h2 class="text-lg font-semibold text-slate-900 mb-4">{g.sources.title}</h2>
      <p class="text-xs text-slate-500 mb-4 italic">{g.sources.disclaimer}</p>
      <ul class="space-y-2 text-sm">
        {g.sources.items.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="external noopener" class="text-primary-700 hover:text-primary-800 underline">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
