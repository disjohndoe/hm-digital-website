---
import Layout from '../layouts/Layout.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import { getTranslations } from '../i18n/ui';

const locale = 'hr';
const t = getTranslations(locale);
const g = t.cezihDeadline;

const siteUrl = 'https://hmdigital.hr';
const pageUrl = `${siteUrl}/cezih-rok-za-privatne-ordinacije/`;
---

<Layout
  title={g.meta.title}
  description={g.meta.description}
  canonical="/cezih-rok-za-privatne-ordinacije/"
  type="article"
  noindex={false}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={g.meta.datePublished} />
    <meta property="article:modified_time" content={g.meta.dateModified} />
    <meta property="article:author" content="HM Digital" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": g.hero.title,
      "description": g.meta.description,
      "datePublished": g.meta.datePublished,
      "dateModified": g.meta.dateModified,
      "inLanguage": "hr",
      "author": { "@type": "Organization", "name": "HM Digital", "url": siteUrl },
      "publisher": {
        "@type": "Organization",
        "name": "HM Digital",
        "url": siteUrl,
        "logo": { "@type": "ImageObject", "url": `${siteUrl}/hm-digital-logo-veliki-social.png` }
      },
      "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
      "image": `${siteUrl}/hm-digital-logo-veliki-social.png`,
      "about": ["CEZIH", "rok za privatne ordinacije", "CEZIH pomak roka", "HZZO", "privatne ordinacije"]
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": g.faq.items.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      }))
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": g.breadcrumb.home, "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": g.breadcrumb.current, "item": pageUrl }
      ]
    })} />
  </Fragment>

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-slate-900 to-primary-900">
    <div class="container-custom max-w-4xl">
      <p class="text-xs sm:text-sm font-semibold tracking-wider text-primary-300 uppercase mb-4">
        {g.hero.eyebrow}
      </p>
      <a href={g.hero.certLink} target="_blank" rel="external noopener" class="inline-flex items-center gap-2 px-3 py-1.5 mb-4 rounded-full bg-green-500/15 border border-green-400/40 text-green-200 text-xs sm:text-sm font-semibold hover:bg-green-500/25 transition-colors">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {g.hero.certBadge}
      </a>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4 leading-tight">
        {g.hero.title}
      </h1>
      <p class="text-base sm:text-lg text-slate-200 mb-5 max-w-3xl">
        {g.hero.subheadline}
      </p>
      <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary-500/20 border border-primary-400/40 text-primary-100 text-sm font-medium mb-6">
        <svg class="w-4 h-4 mr-2 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        {g.hero.promise}
      </div>
      <p class="text-lg sm:text-xl leading-relaxed text-slate-300 mb-8">
        {g.hero.lead}
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <Button href="#sto-sad" variant="primary" size="lg">
          {g.hero.ctaPrimary}
        </Button>
        <Button href="#izvori" variant="outline" size="lg" class="!border-white !text-white hover:!bg-white/10">
          {g.hero.ctaSecondary}
        </Button>
      </div>
    </div>
  </section>

  <!-- Ključno -->
  <section id="kljucno" class="py-12 lg:py-16 bg-amber-50 border-b border-amber-200">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">{g.kljucno.title}</h2>
      <p class="text-lg font-semibold text-slate-800 mb-6">{g.kljucno.lead}</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
        {g.kljucno.points.map((p) => (
          <Card padding="lg" class="bg-white border-l-4 border-primary-500">
            <p class="text-xs uppercase tracking-wider font-semibold text-slate-500 mb-1">{p.label}</p>
            <p class="text-base font-semibold text-slate-900">{p.value}</p>
          </Card>
        ))}
      </div>
      <Card padding="lg" class="bg-white border-2 border-amber-200">
        <p class="text-slate-700 leading-relaxed text-sm">{g.kljucno.note}</p>
      </Card>
    </div>
  </section>

  <!-- Pomak roka -->
  <section id="pomak-roka" class="py-16 lg:py-20 bg-white">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-6">{g.pomakRoka.title}</h2>
      <p class="text-lg font-semibold text-primary-700 mb-4">{g.pomakRoka.answer}</p>

      <h3 class="text-xl font-semibold text-slate-900 mt-10 mb-5">{g.pomakRoka.timelineTitle}</h3>
      <ol class="space-y-4 border-l-2 border-primary-200 pl-6 mb-10">
        {g.pomakRoka.timeline.map((item) => (
          <li class="relative">
            <span class="absolute -left-[31px] top-1 w-4 h-4 rounded-full bg-primary-500 border-4 border-white shadow"></span>
            <p class="text-sm font-semibold text-primary-700 uppercase tracking-wide">{item.date}</p>
            <p class="text-slate-700 leading-relaxed">{item.text}</p>
          </li>
        ))}
      </ol>

      <Card padding="lg" class="bg-slate-50 border-slate-200">
        <h3 class="text-base font-semibold text-slate-900 mb-2">{g.pomakRoka.caveatTitle}</h3>
        <p class="text-slate-700 leading-relaxed text-sm">{g.pomakRoka.caveat}</p>
      </Card>
    </div>
  </section>

  <!-- Tko obuhvaćen -->
  <section id="tko-obuhvacen" class="py-16 lg:py-20 bg-slate-50">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-6">{g.tkoObuhvacen.title}</h2>
      <ul class="space-y-3">
        {g.tkoObuhvacen.items.map((item) => (
          <li class="flex gap-3 text-slate-700 leading-relaxed">
            <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Pametna kartica (kritično pojašnjenje) -->
  <section id="pametna-kartica" class="py-16 lg:py-20 bg-white">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">{g.pametnaKartica.title}</h2>
      <p class="text-slate-700 leading-relaxed mb-6">{g.pametnaKartica.body}</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        {g.pametnaKartica.items.map((item) => (
          <Card padding="lg" class="border-l-4 border-amber-500 bg-amber-50/40">
            <h3 class="text-base font-semibold text-slate-900 mb-1">{item.term}</h3>
            <p class="text-slate-700 text-sm leading-relaxed">{item.desc}</p>
          </Card>
        ))}
      </div>
      <p class="text-xs text-slate-500 italic">{g.pametnaKartica.sourceNote}</p>
    </div>
  </section>

  <!-- Što sad -->
  <section id="sto-sad" class="py-16 lg:py-20 bg-slate-50">
    <div class="container-custom max-w-4xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-4">{g.stoSad.title}</h2>
      <p class="text-slate-700 leading-relaxed mb-8">{g.stoSad.intro}</p>
      <ol class="space-y-6 mb-10">
        {g.stoSad.steps.map((step) => (
          <li class="flex gap-5">
            <div class="shrink-0 w-10 h-10 rounded-full bg-primary-600 text-white font-bold flex items-center justify-center">
              {step.n}
            </div>
            <div>
              <h3 class="text-lg font-semibold text-slate-900 mb-1">{step.title}</h3>
              <p class="text-slate-600 text-sm leading-relaxed">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>

      <Card padding="lg" class="bg-white border-2 border-primary-200 mb-6">
        <p class="text-slate-700 leading-relaxed mb-2">{g.stoSad.ctaText}</p>
        <a href={g.stoSad.ctaHref} class="inline-flex items-center gap-2 text-primary-700 font-semibold hover:text-primary-800">
          {g.stoSad.ctaLabel}
        </a>
      </Card>

      <Card padding="lg" class="bg-primary-700 border-0">
        <p class="text-primary-100 leading-relaxed mb-2">{g.stoSad.productText}</p>
        <a href={g.stoSad.productHref} class="inline-flex items-center gap-2 text-white font-semibold underline hover:text-primary-50">
          {g.stoSad.productLabel}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </Card>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 lg:py-24 bg-white" id="faq">
    <div class="container-custom max-w-3xl">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-8 text-center">{g.faq.title}</h2>
      <div class="space-y-3">
        {g.faq.items.map((item) => (
          <details class="group border border-slate-200 rounded-lg bg-slate-50">
            <summary class="flex items-center justify-between cursor-pointer p-4 sm:p-5 font-medium text-slate-900 hover:bg-slate-100 rounded-lg transition-colors">
              {item.q}
              <svg class="w-5 h-5 text-slate-400 shrink-0 ml-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-4 sm:px-5 pb-4 sm:pb-5 text-slate-600 text-sm leading-relaxed">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="cta" class="py-16 lg:py-24 bg-primary-600">
    <div class="container-custom max-w-3xl text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">{g.cta.title}</h2>
      <p class="text-lg text-primary-100 leading-relaxed mb-8">{g.cta.body}</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={g.cta.primaryHref} variant="primary" size="lg" class="!bg-white !text-primary-700 hover:!bg-primary-50">
          {g.cta.primaryLabel}
        </Button>
        <Button href={g.cta.secondaryHref} variant="outline" size="lg" class="!border-white !text-white hover:!bg-white/10">
          {g.cta.secondaryLabel}
        </Button>
      </div>
    </div>
  </section>

  <!-- Sources -->
  <section id="izvori" class="py-12 lg:py-16 bg-white border-t border-slate-200">
    <div class="container-custom max-w-3xl">
      <h2 class="text-lg font-semibold text-slate-900 mb-4">{g.sources.title}</h2>
      <p class="text-xs text-slate-500 mb-4 italic">{g.sources.disclaimer}</p>
      <ul class="space-y-2 text-sm">
        {g.sources.items.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="external noopener" class="text-primary-700 hover:text-primary-800 underline">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
